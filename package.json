{
  "name": "batch-downloader",
  "version": "1.0.1",
  "description": "A desktop app to batch download YouTube video clips with custom start and end times",
  "main": "electron/main.js",
  "author": "TheCodingPapa",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:client": "cd client && npm install && npm run build",
    "version:patch": "npm version patch --no-git-tag-version",
    "prebuild": "npm run version:patch && npm run build:client",
    "package:mac": "npm run prebuild && electron-builder --mac",
    "package:win": "npm run prebuild && electron-builder --win",
    "package:linux": "npm run prebuild && electron-builder --linux",
    "package:all": "npm run prebuild && electron-builder --mac --win --linux"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^2.0.2",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.thecodingpapa.batch-downloader",
    "productName": "Batch Downloader",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "server/server.js",
      "client/dist/**/*",
      "!**/node_modules/.cache",
      "!**/.DS_Store"
    ],
    "extraResources": [
      {
        "from": "server/yt-dlp",
        "to": "yt-dlp",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/ffmpeg-static/**"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Batch Downloader",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    }
  }
}
