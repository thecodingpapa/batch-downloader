				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># 1. Setup Variables
GITHUB_URL="https://github.com/thecodingpapa/batch-downloader/archive/refs/heads/main.zip"

# Get the path of this Automator App
APP_PATH=$(osascript -e 'tell application "System Events" to get POSIX path of (path to me)')

# Get the folder containing the App (the project root)
TARGET_DIR=$(dirname "$APP_PATH")

# Create temporary directory
TEMP_DIR=$(mktemp -d)

# 2. Download
# -L follows redirects, -s is silent
curl -L -s -o "$TEMP_DIR/project.zip" "$GITHUB_URL"

# 3. Extract
unzip -q "$TEMP_DIR/project.zip" -d "$TEMP_DIR/extracted"

# Identify the inner folder (e.g., batch-downloader-main)
SOURCE_CONTENT=$(find "$TEMP_DIR/extracted" -mindepth 1 -maxdepth 1 -type d | head -n 1)

# 4. Paste and Overwrite
if [ -d "$SOURCE_CONTENT" ]; then
    # Copy contents recursively (-R) to target
    cp -R "$SOURCE_CONTENT/"* "$TARGET_DIR/"
    
    osascript -e 'display notification "Batch Downloader updated successfully." with title "Updater"'
else
    osascript -e 'display notification "Error: Extraction failed." with title "Update Failed"'
fi

# Cleanup
rm -rf "$TEMP_DIR"</string>
					<key>CheckedForUserDefaultShell</key>
