				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># 1. Setup Variables
GITHUB_URL="https://github.com/thecodingpapa/batch-downloader/archive/refs/heads/main.zip"

# Get path of this app
APP_PATH=$(osascript -e 'tell application "System Events" to get POSIX path of (path to me)')
TARGET_DIR=$(dirname "$APP_PATH")

# Create a temp folder
TEMP_DIR=$(mktemp -d)
ZIP_FILE="$TEMP_DIR/project.zip"

# Notify
osascript -e 'display notification "Starting Download..." with title "Updater"'

# 2. DOWNLOAD WITH CHECK
# We capture the "Exit Code". 0 = Success. Anything else = Fail.
curl -L -s -o "$ZIP_FILE" "$GITHUB_URL"
EXIT_CODE=$?

# CHECK 1: Did curl crash?
if [ $EXIT_CODE -ne 0 ]; then
    osascript -e "display alert \"Download Failed\" message \"Curl error code: $EXIT_CODE\""
    rm -rf "$TEMP_DIR"
    exit 1
fi

# CHECK 2: Is the file empty? (Common if permissions deny writing)
if [ ! -s "$ZIP_FILE" ]; then
    osascript -e 'display alert "Download Failed" message " The file was created but is empty (0kb). Check internet or GitHub link."'
    rm -rf "$TEMP_DIR"
    exit 1
fi

# 3. EXTRACT
osascript -e 'display notification "Download valid. Extracting..." with title "Updater"'
unzip -q "$ZIP_FILE" -d "$TEMP_DIR/extracted"

# Find inner folder
SOURCE_CONTENT=$(find "$TEMP_DIR/extracted" -mindepth 1 -maxdepth 1 -type d | head -n 1)

# 4. INSTALL
if [ -d "$SOURCE_CONTENT" ]; then
    cp -R "$SOURCE_CONTENT/"* "$TARGET_DIR/"
    osascript -e 'display notification "Update Complete!" with title "Success" sound name "Glass"'
else
    osascript -e 'display alert "Extraction Failed" message "Zip file was valid, but unzip failed."'
fi

# Cleanup
rm -rf "$TEMP_DIR"</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
